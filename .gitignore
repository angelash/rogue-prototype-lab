# 操作系统和编辑器的本机文件
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.vs/
*.swp
*.swo
*~

# Office 锁文件和临时文件；原始工作簿、文档及素材需要入库
~$*
*.tmp
*.temp

# Blender 自动备份；正式 .blend 制作源保留并由 Git 管理
*.blend1
*.blend2

# 本机配置与凭据；示例配置可以提交
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
/.local/
/local/

# 依赖、虚拟环境、缓存和生成结果
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.cache/
.tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/logs/
/backups/

# 后续原型若使用对应引擎，只忽略生成目录；不忽略源码与源素材
/prototypes/**/Library/
/prototypes/**/Temp/
/prototypes/**/Obj/
/prototypes/**/Logs/
/prototypes/**/UserSettings/
/prototypes/**/Build/
/prototypes/**/Builds/
/prototypes/**/.godot/

# 本 Unity 工程自动生成的 IDE 工程文件；源码、asmdef 和 .meta 保留
/prototypes/proto-013-ring-toss/game/RingTossWorkshop/*.csproj
/prototypes/proto-013-ring-toss/game/RingTossWorkshop/*.sln
/prototypes/proto-013-ring-toss/game/RingTossWorkshop/*.slnx
/prototypes/proto-013-ring-toss/game/RingTossWorkshop/*.unityproj
/prototypes/proto-013-ring-toss/game/RingTossWorkshop/*.userprefs

# 其余独立 Unity 工程的 IDE 生成文件
/prototypes/**/game/*/*.csproj
/prototypes/**/game/*/*.sln
/prototypes/**/game/*/*.slnx
/prototypes/**/game/*/*.unityproj
/prototypes/**/game/*/*.userprefs
